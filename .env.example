# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets:
#   openssl rand -hex 32          -> HANGAR_API_TOKEN
#   openssl rand -hex 24          -> POSTGRES_PASSWORD
#   docker compose run --rm hangar hangar gen-key   -> HANGAR_SECRET_KEY

POSTGRES_PASSWORD=
HANGAR_API_TOKEN=

# Seals per-app database passwords at rest. If this changes, secrets encrypted
# with the old key cannot be read back — keep it somewhere durable.
HANGAR_SECRET_KEY=

# Apps are served at <app-name>.<this>. A DuckDNS subdomain works: any
# *.yourname.duckdns.org resolves to the same IP.
HANGAR_APP_DOMAIN=yourname.duckdns.org
HANGAR_APP_SCHEME=https

# Require sign-in before anyone reaches a deployed app (PRD §8).
HANGAR_APP_AUTH=1

# deny = apps get no outbound network at all.
HANGAR_EGRESS=deny

# flag records findings and continues; block refuses risky deploys.
HANGAR_SCAN_POLICY=flag

# Per-app storage: none, sqlite, or postgres.
HANGAR_APP_DB=sqlite

# Set to runsc once gVisor is installed on the host. Empty means app code
# shares the host kernel — fine for code you wrote, not for anything else.
HANGAR_RUNTIME=
