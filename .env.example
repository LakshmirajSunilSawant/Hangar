# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets:
#   openssl rand -hex 32          -> HANGAR_API_TOKEN
#   openssl rand -hex 24          -> POSTGRES_PASSWORD
#   docker compose run --rm hangar hangar gen-key   -> HANGAR_SECRET_KEY

POSTGRES_PASSWORD=
HANGAR_API_TOKEN=

# Seals per-app database passwords at rest. If this changes, secrets encrypted
# with the old key cannot be read back — keep it somewhere durable.
HANGAR_SECRET_KEY=

# Apps are served at <app-name>.<this>. A DuckDNS subdomain works: any
# *.yourname.duckdns.org resolves to the same IP.
HANGAR_APP_DOMAIN=yourname.duckdns.org
HANGAR_APP_SCHEME=https

# Require sign-in before anyone reaches a deployed app (PRD §8).
HANGAR_APP_AUTH=1

# Scopes the session cookie across subdomains. Required when app auth is on:
# apps live at <name>.<HANGAR_APP_DOMAIN>, and a host-only cookie is never sent
# to them, so every visitor would be refused however many times they signed in.
# The leading dot covers every subdomain.
HANGAR_COOKIE_DOMAIN=.yourname.duckdns.org

# Hostname for the dashboard. Set it and Hangar keeps its own route in Caddy
# alongside the apps' — worth doing, because Caddy's image reloads its packaged
# Caddyfile on restart and drops every route Hangar added. Without this, a
# reboot leaves the dashboard unreachable until you re-add the route by hand.
HANGAR_CONTROL_PLANE_HOST=hangar.yourname.duckdns.org

# deny = apps get no outbound network at all.
HANGAR_EGRESS=deny

# Scale-to-zero. Seconds with no requests before an app's container is stopped;
# the next visit starts it again and the URL never changes. 0 keeps every app
# resident, which is simpler but costs memory for tools nobody is using.
#
# Needs a router: the proxy is what sees the request that wakes the app. The
# container is stopped rather than removed, so waking is a start, not a rebuild.
HANGAR_IDLE_TIMEOUT=1800
HANGAR_IDLE_CHECK_INTERVAL=60

# How long the proxy keeps retrying an app that is still starting. Too short
# and a waking app returns 502; too long and a genuinely broken app hangs the
# browser instead of failing.
HANGAR_WAKE_TIMEOUT=30

# flag records findings and continues; block refuses risky deploys.
HANGAR_SCAN_POLICY=flag

# Per-app storage: none, sqlite, or postgres.
HANGAR_APP_DB=sqlite

# Set to runsc once gVisor is installed on the host. Empty means app code
# shares the host kernel — fine for code you wrote, not for anything else.
HANGAR_RUNTIME=
